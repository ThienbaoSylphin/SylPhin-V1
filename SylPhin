-- Tab 5: Config & Webhook
local SystemTab = HihiHub:CreateTab("Config & Webhook")
SystemTab:AddToggle("Gửi Webhook Discord", "WebhookEnabled")
SystemTab:AddTextbox("Discord Webhook URL", "WebhookURL", "https://discord.com/api/webhooks/...")
SystemTab:AddButton("Lưu Cấu Hình File .JSON", function()
    if writefile then
        writefile("senaV4_config.json", HttpService:JSONEncode(senaV4Config))
        print("[HihiHub x SenaV4] Đã lưu tệp cấu hình!")
    end
end)
SystemTab:AddButton("Nạp Cấu Hình File .JSON", function()
    if readfile and isfile and isfile("senaV4_config.json") then
        local loaded = HttpService:JSONEncode(readfile("senaV4_config.json"))
        for k, v in pairs(loaded) do
            senaV4Config[k] = v
        end
        print("[HihiHub x SenaV4] Đã tải lại tệp cấu hình!")
    end
end)

