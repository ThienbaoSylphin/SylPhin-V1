    end)

    rawmetatable.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        -- Chống Guard Knockback & Hit
        if method == "FireServer" and tostring(self):find("GuardHit") and senaV4Config.AntiHitGuard then
            return nil
        end
        if method == "FireServer" and tostring(self):find("Cutscene") and senaV4Config.AntiCutscene then
            return nil
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(rawmetatable, true)
end

