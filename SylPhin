local function sendWebhookNotification(title, description, color)
	if not senaV4Config.WebhookEnabled or senaV4Config.WebhookURL == "" then return end
	local requestFunc = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
	if not requestFunc then return end

	local embed = {
		title = title,
		description = description,
		color = color or 65280,
		footer = { text = "Sena V4 Hub • Steal An Egg" },
		timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
	}

	pcall(function()
		requestFunc({
			Url = senaV4Config.WebhookURL,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = game:GetService("HttpService"):JSONEncode({ embeds = { embed } })
		})
	end)
end

