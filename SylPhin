	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end)
end

local function AddDropdown(parent, elementId, options, default, callback)
	local DropFrame = Instance.new("Frame")
	DropFrame.Size = UDim2.new(1, 0, 0, 38)
	DropFrame.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
	DropFrame.ClipsDescendants = true
	DropFrame.Parent = parent

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 6)
	Corner.Parent = DropFrame

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(0, 150, 0, 38)
	Label.Position = UDim2.new(0, 10, 0, 0)
	Label.Font = Enum.Font.Gotham
	Label.TextSize = 12
	Label.TextColor3 = Color3.fromRGB(220, 220, 240)
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.BackgroundTransparency = 1
	Label.Parent = DropFrame

	UI_Elements[elementId] = Label

	local SelectedBtn = Instance.new("TextButton")
	SelectedBtn.Size = UDim2.new(0, 120, 0, 26)
	SelectedBtn.Position = UDim2.new(1, -128, 0, 6)
	SelectedBtn.BackgroundColor3 = Color3.fromRGB(36, 36, 48)
	SelectedBtn.Font = Enum.Font.GothamMedium
	SelectedBtn.TextSize = 12
	SelectedBtn.TextColor3 = Color3.fromRGB(0, 229, 255)
	SelectedBtn.Text = default
	SelectedBtn.Parent = DropFrame

	local BtnCorner = Instance.new("UICorner")
	BtnCorner.CornerRadius = UDim.new(0, 4)
	BtnCorner.Parent = SelectedBtn

	local Container = Instance.new("Frame")
	Container.Size = UDim2.new(1, -20, 0, #options * 28)
	Container.Position = UDim2.new(0, 10, 0, 42)
	Container.BackgroundTransparency = 1
	Container.Parent = DropFrame

	local List = Instance.new("UIListLayout")
	List.Padding = UDim.new(0, 3)
	List.Parent = Container

	local open = false
	SelectedBtn.MouseButton1Click:Connect(function()
		open = not open
		DropFrame:TweenSize(open and UDim2.new(1, 0, 0, 45 + #options * 30) or UDim2.new(1, 0, 0, 38), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
	end)

	for _, opt in ipairs(options) do
		local OptBtn = Instance.new("TextButton")
		OptBtn.Size = UDim2.new(1, 0, 0, 26)
		OptBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
		OptBtn.Font = Enum.Font.Gotham
		OptBtn.TextSize = 12
		OptBtn.TextColor3 = Color3.fromRGB(200, 200, 220)
		OptBtn.Text = opt
		OptBtn.Parent = Container

		local OptCorner = Instance.new("UICorner")
		OptCorner.CornerRadius = UDim.new(0, 4)
		OptCorner.Parent = OptBtn

		OptBtn.MouseButton1Click:Connect(function()
			SelectedBtn.Text = opt
			open = false
			DropFrame:TweenSize(UDim2.new(1, 0, 0, 38), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
			callback(opt)
		end)
	end
end

