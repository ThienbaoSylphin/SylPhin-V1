local t46 = {}
t46.__index = t46

function t46.new()
    local self = setmetatable({}, t46)
    self.IsStealing = false
    self.CurrentTarget = nil
    return self
end

function t46:GetBestEgg()
    local bestEgg = nil
    local maxPriorityValue = -1

    local eggsFolder = workspace:FindFirstChild("Eggs") or workspace:FindFirstChild("Plots")
    if not eggsFolder then return nil end

    for _, egg in ipairs(eggsFolder:GetDescendants()) do
        if egg:IsA("Model") and (egg:FindFirstChild("EggValue") or egg:FindFirstChild("Rarity")) then
            local rarity = egg:FindFirstChild("Rarity") and egg.Rarity.Value or "Common"
            local value = egg:FindFirstChild("EggValue") and egg.EggValue.Value or 0

            -- Kiếm tra bộ lọc Rarity
            if table.find(senaV4Config.StealRarities, rarity) and value >= senaV4Config.StealMinValue then
                if value > maxPriorityValue then
                    maxPriorityValue = value
                    bestEgg = egg
                end
            end
        end
    end
    return bestEgg
end

function t46:ExecuteSteal(eggModel)
    if not eggModel or self.IsStealing then return end
    self.IsStealing = true
    self.CurrentTarget = eggModel

    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local targetCFrame = eggModel:GetPrimaryPartCFrame() or eggModel.WorldPivot

        if senaV4Config.FlyAerial then
            targetCFrame = targetCFrame * CFrame.new(0, 10, 0)
        end

        if senaV4Config.StealMode == "Tween" then
            local dist = (char.HumanoidRootPart.Position - targetCFrame.Position).Magnitude
            local speed = 50 * math.max(0.1, senaV4Config.TweenSpeedMultiplier)
            local tInfo = TweenInfo.new(dist / speed, Enum.EasingStyle.Linear)
            local tween = TweenService:Create(char.HumanoidRootPart, tInfo, {CFrame = targetCFrame})
            tween:Play()
            tween.Completed:Wait()
        elseif senaV4Config.StealMode == "Instant" or senaV4Config.StealMode == "Teleport" then
            char.HumanoidRootPart.CFrame = targetCFrame
        end

        -- Giữ thao tác cướp
        task.wait(senaV4Config.StealHoldSeconds)

        -- Kích hoạt Prompt / Remote Cướp Trứng
        local prompt = eggModel:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            fireproximityprompt(prompt)
        end
    end
    self.IsStealing = false
end

