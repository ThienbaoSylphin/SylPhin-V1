    function TabElements:AddSlider(text, configKey, min, max, callback)
        local SliderFrame = Instance.new("Frame")
        SliderFrame.Size = UDim2.new(1, -10, 0, 42)
        SliderFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
        SliderFrame.Parent = PageContainer

