local function UpdateLanguage(lang)
	sylphinConfig.Language = lang
	local dict = Translations[lang] or Translations["Tiếng Việt"]

	for key, element in pairs(UI_Elements) do
		if element and element.Parent then
			if dict[key] then
				element.Text = dict[key]
			end
		end
	end
end

